opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/ppx_log"
bug-reports: "https://github.com/public-release-reloaded/ppx_log/issues"
dev-repo: "git+https://github.com/public-release-reloaded/ppx_log.git#v0.18_preview.130.100+614+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/ppx_log/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "base" {>= "v0.18~" & < "v0.19~"}
  "ppx_compare" {>= "v0.18~" & < "v0.19~"}
  "ppx_enumerate" {>= "v0.18~" & < "v0.19~"}
  "ppx_expect" {>= "v0.18~" & < "v0.19~"}
  "ppx_fields_conv" {>= "v0.18~" & < "v0.19~"}
  "ppx_here" {>= "v0.18~" & < "v0.19~"}
  "ppx_let" {>= "v0.18~" & < "v0.19~"}
  "ppx_sexp_conv" {>= "v0.18~" & < "v0.19~"}
  "ppx_sexp_message" {>= "v0.18~" & < "v0.19~"}
  "ppx_sexp_value" {>= "v0.18~" & < "v0.19~"}
  "ppx_string" {>= "v0.18~" & < "v0.19~"}
  "ppx_template" {>= "v0.18~" & < "v0.19~"}
  "ppx_variants_conv" {>= "v0.18~" & < "v0.19~"}
  "sexplib" {>= "v0.18~" & < "v0.19~"}
  "stdio" {>= "v0.18~" & < "v0.19~"}
  "dune" {>= "3.17.0"}
  "ppxlib" {> "0.38.0"}
]
available: arch != "x86_32"
synopsis: "Ppx_sexp_message-like extension nodes for lazily rendering log messages"
description: "
Part of the Jane Street's PPX rewriters collection. 
"
